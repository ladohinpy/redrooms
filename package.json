{
  "name": "redrooms-telegram",
  "version": "0.3.0",
  "private": true,
  "description": "Красная комната — наборы, конкурсы, контент, JSON-бэкапы",
  "scripts": {
    "check": "node scripts/rr-check.cjs",
    "status": "tgcloud status",
    "test:access": "node tests/access.test.mjs",
    "deploy:access": "node scripts/rr-deploy.cjs",
    "check:legacy": "node scripts/check-app.mjs && node tests/access.test.mjs",
    "rr:prepare": "node scripts/rr-prepare.cjs",
    "rr:test": "node scripts/rr-check.cjs --tests-only",
    "rr:deploy": "node scripts/rr-deploy.cjs --confirm",
    "rr:backup": "node scripts/rr-backup.cjs --confirm"
  },
  "devDependencies": {
    "@tgcloud/cli": "0.2.0"
  },
  "type": "module"
}
